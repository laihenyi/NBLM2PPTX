<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store 版（cargo feature `appstore`）的 entitlements。
  Developer ID 版不開沙盒、不用這個檔；差異見 docs/APP_STORE.md。
-->
<plist version="1.0">
<dict>
	<!-- TestFlight 需要（ITMS-90886）：必須與 provisioning profile 的 App ID、Team 相符 -->
	<key>com.apple.application-identifier</key>
	<string>S6EDV86VSB.com.yikai.nblm2pptx</string>
	<key>com.apple.developer.team-identifier</key>
	<string>S6EDV86VSB</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 唯一的網路用途：第一次使用時從 Hugging Face 下載 LaMa／MobileSAM 模型 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 讀取使用者拖入或在面板選的 PDF，寫入使用者選的輸出資料夾 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 預設輸出位置：下載項目 -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
